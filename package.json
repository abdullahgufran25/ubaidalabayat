{
  "name": "ubaid-al-abayat",
  "version": "1.0.0",
  "description": "Premium Pakistani Fashion/Abaya E-commerce Platform",
  "main": "server/server.js",
  "scripts": {
    "build": "npm run build --prefix client",
    "postinstall": "npm install --prefix client && npm install --prefix server",
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "start": "node server/server.js",
    "build:client": "npm run build --prefix client",
    "seed": "echo 'Seeding is disabled. Please upload products manually from the admin panel.'"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
